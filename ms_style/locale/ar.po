# Login page strings that Frappe 16 ships without Arabic. These entries have no
# context on purpose: they only fill that gap (none of these keys has a translation in
# frappe, erpnext or hrms), so the Arabic login page reads the same as before.
msgid "Sign In"
msgstr "تسجيل الدخول"

msgid "Welcome! Please sign in to continue."
msgstr "مرحبًا! يرجى تسجيل الدخول للمتابعة."

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Mobile"
msgstr "الجوال"

msgid "or"
msgstr "أو"

msgid "Forgot password?"
msgstr "نسيت كلمة المرور؟"

msgid "Continue"
msgstr "متابعة"

msgid "Login with Email Link"
msgstr "تسجيل الدخول برابط البريد الإلكتروني"

msgid "Login with password"
msgstr "تسجيل الدخول بكلمة المرور"

msgid "Login with {0}"
msgstr "تسجيل الدخول باستخدام {0}"

msgid "Send login link"
msgstr "إرسال رابط تسجيل الدخول"

msgid "Send Link"
msgstr "إرسال الرابط"

msgid "Please check your email."
msgstr "يرجى مراجعة بريدك الإلكتروني."

msgid "Didn't receive the link?"
msgstr "لم يصلك الرابط؟"

msgid "Resend"
msgstr "إعادة الإرسال"

msgid "Back to sign in"
msgstr "العودة لتسجيل الدخول"

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Sign Up"
msgstr "إنشاء حساب"

msgid "Let's setup your account."
msgstr "لنبدأ إعداد حسابك."

msgid "Please enter your email, we'll send you password reset link"
msgstr "أدخل بريدك الإلكتروني وسنرسل لك رابط إعادة تعيين كلمة المرور"

msgid "Home"
msgstr "الرئيسية"
